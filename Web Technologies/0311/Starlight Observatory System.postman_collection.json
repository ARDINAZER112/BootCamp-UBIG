      "name": "Authentication",
      "item": [
        {
          "name": "A1a - Login success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has required fields', function () {",
                  "    pm.expect(jsonData).to.have.property('name');",
                  "    pm.expect(jsonData).to.have.property('username');",
                  "    pm.expect(jsonData).to.have.property('member_type');",
                  "    pm.expect(jsonData).to.have.property('born_date');",
                  "    pm.expect(jsonData).to.have.property('gender');",
                  "    pm.expect(jsonData).to.have.property('address');",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData).to.have.property('regional');",
                  "    pm.expect(jsonData.regional).to.have.property('id');",
                  "    pm.expect(jsonData.regional).to.have.property('province');",
                  "    pm.expect(jsonData.regional).to.have.property('district');",
                  "});",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    pm.environment.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
