APP_NAME="Instalment Car API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/XX_SERVER_MODULE/BACKEND

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL / MariaDB bawaan XAMPP & LAMPP
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=instalment_car_db
DB_USERNAME=root
DB_PASSWORD=

# API ini stateless (token Sanctum), jadi tidak butuh tabel session/cache/queue
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Endpoint bantu untuk Postman (validator/reset & validator/approve).
# Ubah ke false jika tidak diperlukan.
ENABLE_TEST_HELPERS=true
